rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Loyalty Cards Collection
    match /loyaltyCards/{cardId} {
      // Allow anyone to read their own card or any card (for QR scanning)
      allow read: if true;
      
      // Only allow writes through Admin SDK (API routes)
      allow write: if false;
    }
    
    // Transactions Collection
    match /transactions/{transactionId} {
      // Allow users to read their own transactions
      allow read: if true;
      
      // Only allow writes through Admin SDK
      allow write: if false;
    }
  }
}
